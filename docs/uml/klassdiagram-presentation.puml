@startuml
title SXX Bokningssystem - Förenklat klassdiagram

top to bottom direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam defaultFontSize 14
skinparam roundcorner 10

' ==========================
' API
' ==========================

package "API" #E8EAF6 {
    class BookingController {
        + CreateBooking()
        + CancelBooking()
        + RegisterCheckout()
        + RegisterReturn()
    }
}

' ==========================
' APPLICATION
' ==========================

package "Application - Systemets funktioner" #EAFBEF {

    class BookingService {
        + CreateBooking()
        + GetCustomerBookings()
        + CancelBooking()
    }

    class CheckoutService {
        + RegisterCheckout()
    }

    class ReturnService {
        + RegisterReturn()
    }

    BookingService -[hidden]right- CheckoutService
    CheckoutService -[hidden]right- ReturnService
}

' ==========================
' DOMAIN
' ==========================

package "Domain - Verksamheten" #EAF4FF {

    class Customer {
        + Name : string
    }

    class EquipmentModel {
        + Name : string
        + DailyPrice : decimal
    }

    class EquipmentItem {
        + InventoryNumber : string
        + IsBookable : bool
    }

    class Booking {
        + BookingNumber : string
        + StartDate : DateOnly
        + EndDate : DateOnly
        + AgreedTotalPrice : decimal
        + Status : BookingStatus
    }

    class Personal {
        + Name : string
    }

    class Checkout {
        + CheckedOutAt : DateTimeOffset
    }

    class Return {
        + ReturnedAt : DateTimeOffset
    }

    ' Verksamhetens relationer

    EquipmentModel "1" -- "0..*" EquipmentItem
    EquipmentItem "1" -- "0..*" Booking
    Customer "1" -- "0..*" Booking

    Booking "1" -- "0..1" Checkout
    Booking "1" -- "0..1" Return

    Personal "1" -- "0..*" Checkout
    Personal "1" -- "0..*" Return
}

' ==========================
' INFRASTRUCTURE
' ==========================

package "Infrastructure - Lagring" #FFF4E5 {

    interface IBookingRepository
    class BookingRepository

    BookingRepository ..|> IBookingRepository
}

' ==========================
' KOPPLINGAR MELLAN LAGER
' ==========================

BookingController --> BookingService
BookingController --> CheckoutService
BookingController --> ReturnService

BookingService --> IBookingRepository
CheckoutService --> IBookingRepository
ReturnService --> IBookingRepository

@enduml
