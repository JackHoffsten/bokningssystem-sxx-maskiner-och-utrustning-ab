@startuml
title Bokningssystem SXX Maskiner och Utrustning AB - Klassdiagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "API" {
  class BookingController {
    - bookingService : BookingService
    - checkoutService : CheckoutService
    - returnService : ReturnService

    + CreateBooking(request : CreateBookingRequest) : ActionResult<BookingResult>
    + GetMyBookings() : ActionResult<List<Booking>>
    + CancelBooking(bookingId : Guid) : ActionResult<CancellationResult>
    + GetBooking(bookingNumber : string) : ActionResult<Booking>
    + RegisterCheckout(bookingNumber : string, inventoryNumber : string) : ActionResult<CheckoutResult>
    + RegisterReturn(bookingNumber : string) : ActionResult<ReturnResult>
  }
}

package "Application" {
  class CreateBookingRequest {
    + ModelId : Guid
    + StartDate : DateOnly
    + EndDate : DateOnly
    + AgreedTotalPrice : decimal
  }

  class BookingResult {
    + Success : bool
    + Message : string
    + Booking : Booking?
    + Error : BookingError?
  }

  class CancellationResult {
    + Success : bool
    + Message : string
    + Error : CancellationError?
  }

  enum CancellationError {
    NotFound
    AlreadyCancelled
    RentalStarted
    TooLate
    SaveFailed
  }

  class CheckoutResult {
    + Success : bool
    + Message : string
  }

  class ReturnResult {
    + Success : bool
    + Message : string
    + Error : ReturnError?
  }

  enum ReturnError {
    NotFound
    InvalidStatus
    SaveFailed
  }

  enum ReturnSaveResult {
    Success
    InvalidStatus
    SaveFailed
  }

  class BookingService {
    - bookingRepository : IBookingRepository
    - timeProvider : TimeProvider

    + CreateBooking(customerId : Guid, request : CreateBookingRequest) : BookingResult
    - ValidateBookingPeriod(startDate : DateOnly, endDate : DateOnly) : bool
    - FindAvailableItem(availability : BookingAvailability, customerId : Guid, request : CreateBookingRequest) : EquipmentItem?
    - GenerateBookingNumber() : string

    + GetCustomerBookings(customerId : Guid) : IReadOnlyList<Booking>
    + CancelBooking(customerId : Guid, bookingId : Guid) : CancellationResult
    + GetBooking(bookingNumber : string) : Booking?
  }

  class CheckoutService {
    - bookingRepository : IBookingRepository

    + RegisterCheckout(bookingNumber : string, inventoryNumber : string, personalId : Guid) : CheckoutResult
  }

  class ReturnService {
    - bookingRepository : IBookingRepository
    - timeProvider : TimeProvider

    + GetBooking(bookingNumber : string) : Booking?
    + RegisterReturn(bookingNumber : string, personalId : Guid) : ReturnResult
  }

  interface IBookingRepository {
    + GetItemsAndBookings(modelId : Guid) : BookingAvailability
    + TrySaveBooking(booking : Booking) : bool

    + GetByCustomerId(customerId : Guid) : IReadOnlyList<Booking>
    + GetById(bookingId : Guid) : Booking?
    + UpdateBooking(booking : Booking) : bool

    + GetBooking(bookingNumber : string) : Booking?
    + GetEquipmentItem(inventoryNumber : string) : EquipmentItem?
    + TrySaveCheckout(booking : Booking, checkout : Checkout) : bool

    + TrySaveReturn(booking : Booking, returnEvent : Return) : ReturnSaveResult
    + GetReturnByBookingId(bookingId : Guid) : Return?
  }

  class BookingAvailability {
    + Items : IReadOnlyList<EquipmentItem>
    + Bookings : IReadOnlyList<Booking>
  }

  enum BookingError {
    InvalidRequest
    Unavailable
  }
}

package "Domain" {
  class Customer {
    + Id : Guid
    + Name : string
    + OrganizationNumber : string
    + Email : string
    + PhoneNumber : string
    + Customer(id : Guid, name : string, organizationNumber : string, email : string, phoneNumber : string)
  }

  class Personal {
    + Id : Guid
    + Name : string
  }

  class EquipmentModel {
    + Id : Guid
    + Name : string
    + Description : string
    + Category : string
    + DailyPrice : decimal
    + EquipmentModel(id : Guid, name : string, description : string, category : string, dailyPrice : decimal)
  }

  class EquipmentItem {
    + Id : Guid
    + InventoryNumber : string
    + EquipmentModelId : Guid
    + IsBookable : bool
    + EquipmentItem(id : Guid, inventoryNumber : string, equipmentModelId : Guid, isBookable : bool = true)
  }

  class Booking {
    + Id : Guid
    + BookingNumber : string
    + CustomerId : Guid
    + EquipmentItemId : Guid
    + StartDate : DateOnly
    + EndDate : DateOnly
    + AgreedTotalPrice : decimal
    + Status : BookingStatus

    + Booking(id : Guid, bookingNumber : string, customerId : Guid, equipmentItemId : Guid, startDate : DateOnly, endDate : DateOnly, agreedTotalPrice : decimal, status : BookingStatus = Confirmed)
    + BlocksPeriodFor(customerId : Guid, startDate : DateOnly, endDate : DateOnly) : bool
    + MarkAsCheckedOut() : void
    + MarkAsReturned() : void
  }

  class Checkout {
    + Id : Guid
    + BookingId : Guid
    + EquipmentItemId : Guid
    + PersonalId : Guid
    + CheckedOutAt : DateTimeOffset
  }

  class Return {
    + Id : Guid
    + BookingId : Guid
    + PersonalId : Guid
    + ReturnedAt : DateTimeOffset
  }

  enum BookingStatus {
    Confirmed
    Cancelled
    CheckedOut
    Returned
  }
}

package "Infrastructure" {
  class BookingRepository {
    + GetItemsAndBookings(modelId : Guid) : BookingAvailability
    + TrySaveBooking(booking : Booking) : bool

    + GetByCustomerId(customerId : Guid) : IReadOnlyList<Booking>
    + GetById(bookingId : Guid) : Booking?
    + UpdateBooking(booking : Booking) : bool

    + GetBooking(bookingNumber : string) : Booking?
    + GetEquipmentItem(inventoryNumber : string) : EquipmentItem?
    + TrySaveCheckout(booking : Booking, checkout : Checkout) : bool

    + TrySaveReturn(booking : Booking, returnEvent : Return) : ReturnSaveResult
    + GetReturnByBookingId(bookingId : Guid) : Return?
  }
}

' API
BookingController --> BookingService
BookingController --> CheckoutService
BookingController --> ReturnService

BookingController ..> CreateBookingRequest
BookingController ..> BookingResult
BookingController ..> CancellationResult
BookingController ..> CheckoutResult
BookingController ..> ReturnResult

' Application
BookingService --> IBookingRepository
BookingService ..> CreateBookingRequest
BookingService ..> BookingResult
BookingService ..> CancellationResult
BookingService ..> Booking : skapar, hämtar och avbokar
BookingService ..> BookingAvailability

CheckoutService --> IBookingRepository
CheckoutService ..> CheckoutResult
CheckoutService ..> Booking : kontrollerar status
CheckoutService ..> EquipmentItem : kontrollerar exemplar
CheckoutService ..> Checkout : skapar

ReturnService --> IBookingRepository
ReturnService ..> ReturnResult
ReturnService ..> Booking : kontrollerar status
ReturnService ..> Return : skapar

BookingResult --> "0..1" Booking
CancellationResult --> CancellationError
ReturnResult --> ReturnError

' Infrastructure
BookingRepository ..|> IBookingRepository
BookingRepository ..> Booking : hämtar och sparar
BookingRepository ..> EquipmentItem : hämtar
BookingRepository ..> Checkout : sparar
BookingRepository ..> Return : sparar och hämtar
BookingRepository ..> ReturnSaveResult : returnerar

' Domain
Customer "1" -- "0..*" Booking : gör
EquipmentModel "1" -- "0..*" EquipmentItem : har
EquipmentItem "1" -- "0..*" Booking : bokas genom

Booking --> BookingStatus

Booking "1" -- "0..1" Checkout : har utlämning
EquipmentItem "1" -- "0..*" Checkout : lämnas ut
Personal "1" -- "0..*" Checkout : registrerar

Booking "1" -- "0..1" Return : har återlämning
Personal "1" -- "0..*" Return : tar emot

note right of ReturnService
  US-37:
  Endast bokningar med status
  CheckedOut får återlämnas.

  US-38:
  PersonalId kommer från
  inloggad personal.

  US-39:
  AgreedTotalPrice ändras inte
  vid tidig återlämning.
end note

note right of BookingRepository
  TrySaveReturn kontrollerar
  status atomärt och sparar
  återlämning samt status Returned
  i samma transaktion.

  Vid fel sparas inga ändringar.
end note

@enduml